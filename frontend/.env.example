# Copy to .env (or .env.local) to override the defaults.
# Base URL of the Spring Boot API
VITE_API_URL=http://localhost:9090/api
# Currency and locale used to format money (any ISO 4217 code / BCP 47 tag)
VITE_CURRENCY=USD
VITE_LOCALE=en-US
# Base URL of the Python forecasting service (ml/)
VITE_ML_URL=http://localhost:8000/api
